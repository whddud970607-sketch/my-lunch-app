# Delivery Shield — root env template (Phase 1C)
# Copy values into apps/api/.env for the Nest API. Never commit real secrets.

# --- Supabase ---
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# Server-only (Nest bootstrap/purge/signed URL). Never ship to Flutter/Web.
# SUPABASE_SERVICE_ROLE_KEY=
# Legacy HS256 JWT secret (optional if Auth only issues JWKS/asymmetric tokens)
# SUPABASE_JWT_SECRET=
# SUPABASE_JWKS_URL=
# SUPABASE_JWT_AUDIENCE=authenticated
# AUTH_JWT_SYMMETRIC_ALGS=HS256
# AUTH_JWT_ASYMMETRIC_ALGS=ES256,RS256,EdDSA
# DATABASE_URL=

# --- API ---
# PORT=4000

# --- Maps / Geocoding (Phase 2+ / map spike) ---
# Server (apps/api/.env): Kakao Local REST
# KAKAO_REST_API_KEY=
# Mobile (apps/mobile/.env): Kakao Map native SDK
# KAKAO_NATIVE_APP_KEY=
# GEOCODING_API_KEY=
# NAVER_MAP_KEY=
# TMAP_KEY=

# --- Optional AI (Phase 2+) ---
# OPENAI_API_KEY=

# --- Contact provider (MVP: carrier ingest only, no live telco API) ---
# CONTACT_DEFAULT_PROVIDER=carrier_ingest
