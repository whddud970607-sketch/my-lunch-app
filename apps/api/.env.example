# Delivery Shield API — Phase 1C / 1C.1
# Copy to apps/api/.env locally. Never commit real values.

PORT=4000

# Required for issuer + JWKS URL + user-scoped Supabase client
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Server-only: admin/purge/signed-url paths. Never ship to Flutter/Web.
SUPABASE_SERVICE_ROLE_KEY=

# Legacy HS256 shared secret (Dashboard JWT Secret). Keep for tokens still signed HS256.
# Prefer JWKS/asymmetric when Auth issues ES256/RS256 (see SUPABASE_JWKS_URL).
SUPABASE_JWT_SECRET=

# Optional JWKS override (default: ${SUPABASE_URL}/auth/v1/.well-known/jwks.json)
# SUPABASE_JWKS_URL=

# Optional claim overrides (defaults match Supabase Auth access tokens)
# SUPABASE_JWT_AUDIENCE=authenticated

# Optional algorithm allowlists (comma-separated). Unexpected algs are rejected.
# AUTH_JWT_SYMMETRIC_ALGS=HS256
# AUTH_JWT_ASYMMETRIC_ALGS=ES256,RS256,EdDSA

# Future ContactProvider (MVP: no live provider API)
# CONTACT_DEFAULT_PROVIDER=carrier_ingest

# Account recovery — dev/test stub identity verification (NEVER use stub in production)
IDENTITY_PROVIDER=stub
# Required when IDENTITY_PROVIDER=stub. Set locally in apps/api/.env only — never commit.
STUB_IDENTITY_OTP=
IDENTITY_VERIFICATION_TTL_SECONDS=600
RECOVERY_TOKEN_TTL_SECONDS=900
RECOVERY_MAX_ATTEMPTS_PER_HOUR=20

# Optional: override fixture driver UUID for seed-test-driver-identity.mjs
# TEST_DRIVER_USER_ID=

# Kakao Local REST (server-only Geocoding). Never ship to Flutter.
KAKAO_REST_API_KEY=

# Naver Cloud Platform Map Geocoding v2 (server-only). Never ship to Flutter.
NAVER_MAP_CLIENT_ID=
NAVER_MAP_CLIENT_SECRET=

# VWorld Open API (server-only building geometry research). Never ship to Flutter.
# Register domain e.g. localhost at https://www.vworld.kr/dev/v4dv_apikey2_s001.do
VWORLD_API_KEY=
VWORLD_DOMAIN=localhost

# 공공데이터포털 — 건축HUB 건축물대장정보 (dataset 15134735). Server-only.
DATA_GO_KR_SERVICE_KEY=

# P0-B3-1: job-neutral Workday execution Session (default OFF — B2 unchanged).
# WORKDAY_EXECUTION_SESSION_V1=false

# AES-256-GCM key for delivery_point_access_secrets (64-char hex or 32-byte base64).
# Server-only. Never commit real values. Never log this value.
ACCESS_INFO_KEY=
