# Delivery Shield mobile — Phase 1D
# Copy to apps/mobile/.env and fill publishable/anon key only.
# NEVER put SUPABASE_SERVICE_ROLE_KEY / secret keys here.

SUPABASE_URL=https://rjfkavkrqzdihyhmlhur.supabase.co
SUPABASE_ANON_KEY=
# Runtime profile: local | staging | production
# Staging/production APKs must set DS_ENV + HTTPS API_BASE_URL via --dart-define.
# Staging tester:
# --dart-define=DS_ENV=staging
# --dart-define=API_BASE_URL=https://delivery-shield-api-staging.onrender.com/v1
# Do not use 127.0.0.1 / 10.0.2.2 / adb reverse for staging tester builds.
DS_ENV=local
# Android emulator → host machine Nest API (local profile only)
API_BASE_URL=http://10.0.2.2:4000/v1
# iOS simulator often uses:
# API_BASE_URL=http://127.0.0.1:4000/v1

# Kakao Map SDK (Native app key). Do NOT put KAKAO_REST_API_KEY / Admin key here.
KAKAO_NATIVE_APP_KEY=

# TMAP Navi SDK PoC (debug-only). Optional — empty keeps TMAP PoC gated.
# Never commit real values. Do not put service/secret keys here.
TMAP_CLIENT_ID=
TMAP_API_KEY=
TMAP_USER_KEY=
TMAP_DEVICE_KEY=

# Naver Map (NCP Mobile Dynamic Map Client ID). Optional until issued.
# Leave empty to keep Naver feature gated (no crash). Never put Client Secret here.
# Register Android package: com.deliveryshield.delivery_shield_mobile
# Register iOS Bundle ID: com.deliveryshield.deliveryShieldMobile
# Feature flag (default false): use Operation Queue for delivery complete.
# When false, existing map-spike complete path is unchanged.
COMPLETE_VIA_SYNC_QUEUE=false

# B3 execution Session UX (mirrors server WORKDAY_EXECUTION_SESSION_V1).
# When false, B2 job-picker start path is unchanged.
WORKDAY_EXECUTION_SESSION_V1=false

# Leave empty in production — server uses Seoul service-date (no fixture fallback).
# TODAY_SERVICE_DATE=2026-08-27
